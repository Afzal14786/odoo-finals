{
  "name": "@urban-furniture/backend",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",

    "dev:gateway": "pnpm --filter @urban-furniture/api-gateway dev",
    "dev:core": "pnpm --filter @urban-furniture/core-service dev",
    "dev:accounting": "pnpm --filter @urban-furniture/accounting-service dev",
    "dev:reporting": "pnpm --filter @urban-furniture/reporting-service dev",

    "db:generate": "pnpm --filter @urban-furniture/database db:generate",
    "db:migrate": "pnpm --filter @urban-furniture/database db:migrate",
    "db:push": "pnpm --filter @urban-furniture/database db:push",
    "db:seed": "pnpm --filter @urban-furniture/database db:seed",

    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}